PORT=3000
NODE_ENV=development

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nest_base_db

JWT_ACCESS_SECRET=dev-secret-change-me
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=7

RESET_CODE_EXPIRES_IN_MINUTES=15
RESET_CODE_MAX_ATTEMPTS=5

MAIL_DRIVER=console
MAIL_FROM=no-reply@crm-default.local

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

CORS_ORIGIN=http://localhost:5173

THROTTLE_TTL=60
THROTTLE_LIMIT=10

AUTH_FIXED_RESET_CODE_ENABLED=false
AUTH_FIXED_RESET_CODE=123456